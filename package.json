{
  "name": "spotflow-studio",
  "version": "2.0.0",
  "description": "Modern Spotify Playlist Downloader & Auto-Sync Studio powered by React, TypeScript, Bun, and Cron schedules",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"green,cyan\" \"bun run server/index.ts\" \"vite\"",
    "be": "bun run server/index.ts",
    "backend": "bun run server/index.ts",
    "fe": "vite",
    "frontend": "vite",
    "server": "bun run server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "stop": "./stop.sh",
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"green,cyan\" \"bun run server/index.ts\" \"vite\""
  },
  "dependencies": {
    "croner": "^9.0.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
